# Copy to .env and fill in. Never commit .env (it's git-ignored).

# NVIDIA (OpenAI-compatible) — get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OPTIONAL. Leave unset to allow all origins (fine for this app). Only set it if
# you want to lock the backend to your frontend URL, e.g. https://beacon.vercel.app
# ALLOWED_ORIGIN=

# Port (Render sets this automatically)
PORT=8787
