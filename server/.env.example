# Copy to .env and fill in. Never commit .env (it's git-ignored).

# NVIDIA (OpenAI-compatible) — get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Comma-separated allowed origins (your Vercel URL in production)
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:4173

# Port (Render sets this automatically)
PORT=8787
